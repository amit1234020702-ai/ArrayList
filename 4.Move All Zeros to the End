import java.util.*;

public class Main {
    public static void main(String[] args) {

        ArrayList<Integer> list = new ArrayList<>(
                Arrays.asList(0,1,0,3,12,0,5));

        ArrayList<Integer> result = new ArrayList<>();

        for(int num:list){
            if(num!=0){
                result.add(num);
            }
        }

        while(result.size()<list.size()){
            result.add(0);
        }

        System.out.println(result);
    }
}
